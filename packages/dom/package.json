{
  "name": "@stra/dom",
  "version": "0.1.0",
  "description": "STRA - DOM projection layer: semantic tree to DOM render",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {"@stra/types":"workspace:*"},
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5"
  },
  "license": "MIT"
}
