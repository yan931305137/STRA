{
  "name": "@stra/renderer-html",
  "version": "0.1.0",
  "description": "STRA - HTML renderer: semantic tree to HTML projection",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stra/types": "workspace:*",
    "@stra/core": "workspace:*",
    "@stra/renderer-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^6",
    "vite-plugin-dts": "^4"
  },
  "license": "MIT"
}
