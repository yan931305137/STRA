{
  "name": "@stra/bundler",
  "version": "0.1.0",
  "description": "STRA - Build core: graph-walk + tree-shaking + chunk generation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "PUBLIC_API.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stra/shared-node": "workspace:*",
    "@stra/plugin": "workspace:*",
    "@stra/resolver": "workspace:*",
    "@stra/transform": "workspace:*",
    "@stra/module-graph": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5"
  },
  "license": "MIT"
}
