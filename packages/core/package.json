{
  "name": "@stra/core",
  "version": "0.1.0",
  "description": "STRA - Semantic runtime kernel: Tree / Signal / Action / Lifecycle / Scheduler",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "PUBLIC_API.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stra/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "license": "MIT"
}
